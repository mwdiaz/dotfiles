#!/usr/bin/env zsh
# shellcheck disable=all

set -euo pipefail

readonly HOMEBREW_PKG_PATH="/tmp/homebrew.pkg"

# Print an error message with a timestamp to stderr.
#
# Arguments:
#   Any number of strings that will be joined and printed as the error text.
#
# Example output:
#   [2026-05-06T14:35:10-0700]: Failed to download Homebrew package.
function error() {
  echo "[$(date "+%Y-%m-%dT%H:%M:%S%z")]: $*" >&2
}

function {
  if command -v brew &> /dev/null; then
    echo "Homebrew is already installed at $(where brew). Skipping installation..."
  else
    echo "Installing Homebrew..."
    local OS
    OS="$(uname)"

    case "${OS}" in
      "Darwin")
        # Install using `.pkg` installer, which feels a bit more safe than
        # running the convenience script.
        {{- $HOMEBREW_REPO := "Homebrew/brew" -}}
        {{- $HOMEBREW_PKG := "Homebrew.pkg" -}}
        {{- $homebrewLatestTagName := (gitHubLatestTag $HOMEBREW_REPO).Name -}}
        echo "Detected macOS, installing Homebrew version {{ $homebrewLatestTagName }} from {{ $HOMEBREW_REPO }}..."

        # While `((gitHubLatestRelease $HOMEBREW_REPO).Assets | first).BrowserDownloadURL`
        # would be less complex, it may fail in the case additional assets are
        # added to Homebrew releases in the future.
        homebrew_pkg_download_url="{{ gitHubLatestReleaseAssetURL $HOMEBREW_REPO $HOMEBREW_PKG }}"

        curl --fail --location --show-error --silent --output "${HOMEBREW_PKG_PATH}" \
          "${homebrew_pkg_download_url}"

        if (( $? != 0 )); then
          error "Failed to download Homebrew package installer from ${homebrew_pkg_download_url}. Exiting..."
          return 1
        fi

        if [[ -f "${HOMEBREW_PKG_PATH}" ]]; then
          echo "Homebrew package installer downloaded to ${HOMEBREW_PKG_PATH}"
        else
          error "Homebrew package installer download failed. File was not found at ${HOMEBREW_PKG_PATH}. Exiting..."
          return 1
        fi

        echo "Installing Homebrew at root volume mount point /..."
        sudo installer -package "${HOMEBREW_PKG_PATH}" -target "/"

        if command pkgutil --pkg-info "sh.brew.homebrew" &> /dev/null; then
          echo "Homebrew installed successfully to $(builtin where brew)."

          # Source Homebrew environment to ensure brew commands work in this script
          eval "$(brew shellenv)"

          rm -f -v "${HOMEBREW_PKG_PATH}"
        else
          error "Homebrew installation failed. Please confirm that the file at ${HOMEBREW_PKG_PATH} is a valid package. You may download the .pkg file manually at https://github.com/{{ $HOMEBREW_REPO }}/releases/latest."
          return 1
        fi
      ;;

      "Linux")
        # Install with Bash shell script (https://github.com/Homebrew/install)
        echo "Detected Linux, installing Homebrew with Bash shell script..."
        NONINTERACTIVE=1 /bin/bash -c "$(
          curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
        )"
        echo "Installation script ran successfully. Exiting..."
      ;;

      *)
        error "Unexpected OS: ${OS}. Homebrew is only supported on macOS and Linux. Exiting..."
        return 1
      ;;
    esac
  fi
}

# Bootstrap CLI tools needed by subsequent scripts. In particular, Homebrew
# uses the GitHub CLI (`gh`) to verify attestations, and the Personal Access
# Token needs to be read from 1password.
for formula in "1password-cli" "gh"; do
  if ! brew list "$formula" &>/dev/null; then
    echo "Installing $formula..."
    brew install "$formula"
  fi
done
