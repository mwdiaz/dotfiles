{
  ".local/share/oh-my-zsh": {
      "exact": true,
      "refreshPeriod": "168h",
      "stripComponents": 1,
      "type": "archive",
      "url": "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
  },

  ".config/oh-my-zsh/plugins/atuin/atuin.plugin.zsh": {
    "refreshPeriod": "672h",
    "type": "file",
    "url": "https://raw.githubusercontent.com/atuinsh/atuin/refs/heads/main/atuin.plugin.zsh"
  },

  ".config/oh-my-zsh/plugins/zsh-autosuggestions": {
      "exact": true,
      "refreshPeriod": "168h",
      "stripComponents": 1,
      "type": "archive",
      "url": "https://github.com/zsh-users/zsh-autosuggestions/archive/master.tar.gz"
  },

  ".config/oh-my-zsh/themes/spaceship-prompt": {
    "clone": {
      "args": ["--depth", "1"]
    },
    "pull": {
      "args": ["--ff-only"]
    },
    "refreshPeriod": "672h",
    "type": "git-repo",
    "url": "git@github.com:spaceship-prompt/spaceship-prompt.git"
  }
}
